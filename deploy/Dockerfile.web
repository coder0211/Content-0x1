# Web image: builds the Vite SPA with pnpm and serves the static bundle with
# an unprivileged nginx on :8080. TLS, /api and SSE proxying are done by the
# edge nginx (deploy/staging/nginx.conf.template); this container only serves files.
FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
# Same-origin API behind the edge proxy; never build with mocking enabled.
ENV VITE_API_BASE_URL=/api/v1 VITE_API_MOCKING=false
RUN pnpm build && rm -f dist/mockServiceWorker.js

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY deploy/web/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 8080
