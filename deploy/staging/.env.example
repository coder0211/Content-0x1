# Staging environment (ACS-106). Copy to /opt/acs/deploy/staging/.env on the VM
# (chmod 600, owner deploy). Every CHANGE_ME comes from the secret store —
# never commit real values. Variable names match api/internal/platform/config.

# --- images (set by the CD workflow) ---
REGISTRY=ghcr.io/CHANGE_ME_ORG/acs
IMAGE_TAG=latest

# --- public hosts (TLS cert in ./certs must cover both) ---
APP_HOST=acs-staging.example.com
S3_HOST=s3.acs-staging.example.com

# --- app ---
APP_ENV=staging
HTTP_ADDR=:8080
APP_BASE_URL=https://acs-staging.example.com
LOG_LEVEL=info
CORS_ORIGINS=https://acs-staging.example.com
COOKIE_SECURE=true
SIGNED_URL_TTL=15m
# Staging uses REAL providers (with a small separate budget, see below).
ENABLE_FAKE_PROVIDERS=false

# --- database ---
POSTGRES_USER=acs
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=acs
DATABASE_URL=postgres://acs:CHANGE_ME@postgres:5432/acs?sslmode=disable

# --- redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --- object storage (MinIO via the TLS edge; see nginx.conf.template) ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=s3.acs-staging.example.com
S3_PUBLIC_ENDPOINT=s3.acs-staging.example.com
S3_USE_SSL=true
S3_REGION=us-east-1
S3_BUCKET=acs-assets-staging
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- mail (budget alerts) ---
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_FROM=AI Content Studio Staging <no-reply@example.com>

# --- workers ---
WORKER_CONCURRENCY=10

# --- AI provider keys (referenced by ai_providers.secret_ref; never in the DB) ---
PROVIDER_ANTHROPIC_API_KEY=CHANGE_ME
PROVIDER_OPENAI_API_KEY=CHANGE_ME
PROVIDER_GOOGLE_API_KEY=CHANGE_ME

# --- staging budget ---
# The budget lives in the DB (budget_settings), not in env. After the first
# migration set a small separate staging budget once (Admin UI Settings ›
# Budget, or): UPDATE budget_settings SET global_monthly_limit = 50;
# and set the same value in deploy/observability/prometheus/alerts.yml.

# --- backups (ACS-103) ---
BACKUP_HOST_DIR=/var/backups/acs
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=acs-backups-staging
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
# Optional: encrypt dumps with age (public key only on the VM).
BACKUP_AGE_RECIPIENT=

# --- observability ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
