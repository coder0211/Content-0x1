# Edge nginx for staging/production (ACS-106). Rendered by the official
# nginx image's envsubst step (/etc/nginx/templates/*.template): only
# ${APP_HOST} and ${S3_HOST} are substituted, nginx $variables are untouched.
#
#   https://${APP_HOST}/          → web (static SPA)
#   https://${APP_HOST}/api/      → api:8080 (SSE route unbuffered)
#   https://${S3_HOST}/           → minio:9000 (presigned GET/PUT from browsers)
#
# /metrics and /readyz are never routed publicly; Prometheus scrapes api:8080
# on the private network.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Redact signed-URL query strings from access logs (SPEC-02 §7).
log_format acs_redacted '$remote_addr - [$time_local] "$request_method $uri" '
                        '$status $body_bytes_sent $request_time "$http_user_agent" '
                        'rid=$upstream_http_x_request_id';

upstream acs_api { server api:8080; keepalive 32; }
upstream acs_web { server web:8080; }
upstream acs_s3  { server minio:9000; }

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_HOST} ${S3_HOST};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    server_tokens off;

    access_log /var/log/nginx/access.log acs_redacted;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 2m; # JSON only; files go straight to S3 via presigned PUT

    # Never expose internal endpoints.
    location = /metrics { return 404; }
    location = /readyz  { return 404; }

    location = /healthz {
        proxy_pass http://acs_api;
        access_log off;
    }

    # SSE: job progress stream. No buffering, long read timeout (server pings every 15s).
    location ~ ^/api/v1/jobs/[^/]+/events$ {
        proxy_pass http://acs_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        gzip off;
        add_header X-Accel-Buffering no;
        chunked_transfer_encoding on;
    }

    location /api/ {
        proxy_pass http://acs_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://acs_web;
        proxy_set_header Host $host;
    }
}

# Object storage endpoint used for presigned URLs. Containers reach MinIO
# through this same TLS host (network alias on the nginx service), so a single
# S3 endpoint/signature host works for both server and browser.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${S3_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    access_log /var/log/nginx/s3_access.log acs_redacted;

    client_max_body_size 600m;   # >= UPLOAD_MAX_VIDEO_BYTES
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://acs_s3;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;   # must match the signed host
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
