# Local defaults (matching docker-compose.yml). Copy to .env to override.
# Never commit real secrets; provider keys are read from the env var named
# by ai_providers.secret_ref (e.g. PROVIDER_ANTHROPIC_API_KEY).
APP_ENV=local
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgres://acs:acs@localhost:5432/acs?sslmode=disable
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=acs-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
SIGNED_URL_TTL=15m
SMTP_HOST=localhost
SMTP_PORT=1025
WORKER_QUEUES=text,image,video,render,maintenance
ENABLE_FAKE_PROVIDERS=true
